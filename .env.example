# ==================================
# MCPH Environment Variables
# ==================================

# Node Environment
NODE_ENV=production

# Next.js Configuration
NEXT_TELEMETRY_DISABLED=1

# Google Cloud Platform
GCP_PROJECT_ID=your-gcp-project-id
REGION=us-central1

# Firebase Configuration
GOOGLE_APPLICATION_CREDENTIALS=./service-account-credentials.json

# Google Cloud Storage
GCS_BUCKET_NAME=your-gcs-bucket-name
GCS_DEFAULT_BUCKET_LOCATION=US

# Vertex AI
VERTEXAI_EMBEDDING_MODEL=textembedding-gecko@003

# Google OAuth (for MCP Server)
GOOGLE_OAUTH_CLIENT_ID=your-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-oauth-client-secret

# Cloud Run Specific
PORT=3000  # 3000 for webapp, 8080 for MCP server

# ==================================
# GitHub Actions Secrets Required
# ==================================
# GCP_SA_KEY - Service account JSON key for deployment
# ARTIFACT_REGISTRY_LOCATION - Location of Artifact Registry (e.g., us-central1)
# ARTIFACT_REGISTRY_REPO - Repository name in Artifact Registry
# GCP_PROJECT_ID - Google Cloud Project ID
# REGION - Deployment region for Cloud Run services
# VERTEXAI_EMBEDDING_MODEL - Vertex AI embedding model name
# GCS_BUCKET_NAME - Google Cloud Storage bucket name
# GCS_DEFAULT_BUCKET_LOCATION - Default location for GCS bucket
# GOOGLE_OAUTH_CLIENT_ID - OAuth client ID
# GOOGLE_OAUTH_CLIENT_SECRET - OAuth client secret